{
  "manifestVersion": 2,
  "hostApiMajor": 2,
  "id": "bottogram-plugin-inshopa-local",
  "name": "Inshopa (local development)",
  "version": "0.6.0",
  "executionStatus": "live",
  "description": "Local development storefront navigation and seller paid-order alerts. API requests use the existing WSL loopback backend; Telegram Mini App links still require a reachable HTTPS storefront.",
  "requiresBotFields": [
    "adminTelegramUserId"
  ],
  "setupFields": [
    {
      "key": "apiKey",
      "label": "Inshopa API key",
      "type": "secret",
      "required": true,
      "helpText": "The existing seller key identifies the shop for alerts. Keep storefront:read for shop lookup and shop:orders:read for order alerts. Opening website pages needs no buyer permission."
    },
    {
      "key": "storefrontUrl",
      "label": "Storefront URL",
      "type": "text",
      "required": true,
      "helpText": "The exact registered shop origin. Telegram Mini App buttons require HTTPS. Website login and checkout remain on the existing site."
    }
  ],
  "settings": [
    {
      "key": "notifyNewSuccessfulPurchases",
      "type": "boolean",
      "label": "آگاه شدن از آخرین خرید های موفق",
      "default": true,
      "helpText": "Notify the admin about orders first observed as paid after the initial history scan. Requires shop:orders:read."
    }
  ],
  "automations": [
    {
      "id": "buyer-navigation",
      "trigger": {
        "type": "telegram.command.v2",
        "config": {
          "commands": [
            "start",
            "shop",
            "products"
          ],
          "chatTypes": [
            "private"
          ],
          "arguments": "ignore"
        }
      },
      "actions": [
        {
          "id": "reply-navigation",
          "type": "telegram.reply.v2",
          "config": {
            "text": "Visit the shop or view your orders. Sign in on the shop website if asked.",
            "inlineKeyboard": [
              [
                {
                  "text": "Open shop",
                  "webApp": {
                    "originField": "storefrontUrl",
                    "path": "/"
                  }
                },
                {
                  "text": "My orders",
                  "webApp": {
                    "originField": "storefrontUrl",
                    "path": "/orders"
                  }
                }
              ]
            ]
          },
          "errorMap": {
            "configuration.invalid_public_origin": "shopUrlInvalid",
            "telegram.delivery_unconfirmed": "deliveryUnconfirmed"
          }
        }
      ]
    },
    {
      "id": "buyer-orders",
      "trigger": {
        "type": "telegram.command.v2",
        "config": {
          "commands": [
            "orders"
          ],
          "chatTypes": [
            "private"
          ],
          "arguments": "ignore"
        }
      },
      "actions": [
        {
          "id": "reply-orders",
          "type": "telegram.reply.v2",
          "config": {
            "text": "View your purchases on the shop website. Sign in there if asked.",
            "inlineKeyboard": [
              [
                {
                  "text": "My orders",
                  "webApp": {
                    "originField": "storefrontUrl",
                    "path": "/orders"
                  }
                }
              ]
            ]
          },
          "errorMap": {
            "configuration.invalid_public_origin": "shopUrlInvalid",
            "telegram.delivery_unconfirmed": "deliveryUnconfirmed"
          }
        }
      ]
    },
    {
      "id": "buyer-help",
      "trigger": {
        "type": "telegram.command.v2",
        "config": {
          "commands": [
            "help"
          ],
          "chatTypes": [
            "private"
          ],
          "arguments": "ignore"
        }
      },
      "actions": [
        {
          "id": "reply-help",
          "type": "telegram.reply.v2",
          "config": {
            "text": "Open the shop to browse and buy. Open My orders to see your purchases. Sign in only on the shop website. Never send passwords or sign-in codes in this chat.",
            "inlineKeyboard": [
              [
                {
                  "text": "Open shop",
                  "webApp": {
                    "originField": "storefrontUrl",
                    "path": "/"
                  }
                },
                {
                  "text": "My orders",
                  "webApp": {
                    "originField": "storefrontUrl",
                    "path": "/orders"
                  }
                }
              ]
            ]
          },
          "errorMap": {
            "configuration.invalid_public_origin": "shopUrlInvalid",
            "telegram.delivery_unconfirmed": "deliveryUnconfirmed"
          }
        }
      ]
    },
    {
      "id": "paid-orders",
      "enabledBySetting": "notifyNewSuccessfulPurchases",
      "trigger": {
        "type": "http.poll-list.v1",
        "config": {
          "intervalSeconds": 60,
          "initialSync": "baseline",
          "lookup": {
            "request": {
              "method": "GET",
              "url": "http://127.0.0.1:8080/v1/storefront",
              "authentication": {
                "type": "bearer",
                "secretField": "apiKey"
              },
              "headers": {
                "Origin": {
                  "field": "storefrontUrl",
                  "transform": "url.origin"
                },
                "X-Storefront-Host": {
                  "field": "storefrontUrl",
                  "transform": "url.authority"
                }
              }
            },
            "bindings": {
              "shopId": "id"
            }
          },
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8080/v1/shops/{shopId}/orders",
            "authentication": {
              "type": "bearer",
              "secretField": "apiKey"
            },
            "headers": {
              "Origin": {
                "field": "storefrontUrl",
                "transform": "url.origin"
              },
              "X-Storefront-Host": {
                "field": "storefrontUrl",
                "transform": "url.authority"
              }
            }
          },
          "response": {
            "itemsPath": "orders",
            "itemIdPath": "id"
          },
          "filter": {
            "path": "status",
            "equals": "paid"
          },
          "pagination": {
            "limitQueryParameter": "limit",
            "offsetQueryParameter": "offset",
            "pageSize": 100,
            "maxPages": 1000,
            "pageDelaySeconds": 2
          }
        },
        "errorMap": {
          "http.unauthorized": "shopAccessDenied",
          "http.forbidden": "shopAccessDenied",
          "http.credentials_unavailable": "keyUnavailable",
          "http.timeout": "connectionUnavailable",
          "http.request_failed": "connectionUnavailable",
          "http.invalid_response": "connectionUnavailable",
          "poll.scan_limit_exceeded": "orderScanLimit"
        }
      },
      "actions": [
        {
          "id": "notify-admin",
          "type": "telegram.notify-admin.v1",
          "config": {
            "text": "New paid order\nShop: {{event.shop_name}}\nOrder: {{event.id}}\nAmount: {{event.total_irr}} {{event.currency}}"
          },
          "errorMap": {
            "telegram.delivery_unconfirmed": "deliveryUnconfirmed"
          }
        }
      ]
    }
  ],
  "telegram": {
    "menuButton": {
      "text": "Open shop",
      "webApp": {
        "originField": "storefrontUrl",
        "path": "/"
      }
    }
  },
  "errorMessages": {
    "shopAccessDenied": {
      "title": "Shop access denied",
      "message": "Inshopa rejected the shop connection.",
      "help": "Check the API key, its permissions and the registered shop address.",
      "action": "editPluginParameters"
    },
    "keyUnavailable": {
      "title": "Shop key unavailable",
      "message": "The saved Inshopa API key could not be used.",
      "help": "Unlock secure storage and check the saved key in the plugin parameters.",
      "action": "editPluginParameters"
    },
    "orderScanLimit": {
      "title": "Order scan limit reached",
      "message": "The order history exceeds this plugin’s configured scan limit.",
      "help": "Contact the plugin author before increasing the limit."
    },
    "shopUrlInvalid": {
      "title": "Shop link unavailable",
      "message": "Opening the shop in Telegram requires a valid HTTPS address.",
      "help": "Use the existing shop’s HTTPS origin without a page path, credentials, query or fragment.",
      "action": "editPluginParameters"
    },
    "connectionUnavailable": {
      "title": "Shop connection unavailable",
      "message": "The Inshopa API could not complete the request.",
      "help": "Check the network and service availability, then try again.",
      "action": "retry"
    },
    "deliveryUnconfirmed": {
      "title": "Telegram delivery unconfirmed",
      "message": "Telegram did not confirm this message’s delivery.",
      "help": "Check the existing conversation before retrying; the message may already have arrived."
    }
  }
}
