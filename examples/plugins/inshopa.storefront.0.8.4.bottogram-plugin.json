    },
    {
      "id": "admin-channel",
      "trigger": {
        "type": "telegram.interaction.v1",
        "config": {
          "routes": [
            {
              "kind": "command",
              "name": "channel",
              "argument": "none"
            },
            {
              "kind": "callback",
              "name": "channel",
              "argument": "none"
            }
          ],
          "failureText": "این بخش فعلاً در دسترس نیست. دوباره تلاش کن یا با /start به منوی فروشگاه برگرد.",
          "audience": "admin"
        }
      },
      "actions": [
        {
          "id": "check-channel",
          "type": "telegram.status.v1",
          "config": {
            "channelField": "telegramChannelId",
            "channelLabels": {
              "unset": "تنظیم نشده",
              "ready": "مجوز ارسال پست تأیید شد",
              "denied": "مجوز ارسال عکس تأیید نشد"
            },
            "photo": true
          }
        },
        {
          "id": "present",
          "type": "telegram.present.v1",
          "config": {
            "lines": [
              {
                "text": "کانال‌ها و گروه‌های فروشگاه",
                "maxLength": 80
              },
              {
                "text": "{{event.status.channel}}",
                "maxLength": 300,
                "unless": "status.destinations"
              },
              {
                "text": "{{event.status.destinations}}",
                "maxLength": 900,
                "when": "status.destinations"
              }
            ],
            "keyboard": [
              [
                {
                  "text": "پنل مدیریت این‌شاپا",
