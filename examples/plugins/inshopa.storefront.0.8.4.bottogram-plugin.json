          ],
          "failureText": "این بخش فعلاً در دسترس نیست. دوباره تلاش کن یا با /start به منوی فروشگاه برگرد.",
          "audience": "admin"
        }
      },
      "actions": [
        {
          "id": "shop-profile",
          "type": "http.get-json.v1",
          "config": {
            "request": {
              "method": "GET",
              "url": "https://api.inshopa.ir/v1/storefront",
              "authentication": {
                "type": "bearer",
                "secretField": "apiKey"
              },
              "headers": {
                "Origin": {
                  "field": "storefrontUrl",
                  "transform": "url.origin"
                },
                "X-Storefront-Host": {
                  "field": "storefrontUrl",
                  "transform": "url.authority"
                }
              }
            },
            "resultKey": "shop",
            "useLastResponse": true
          }
        },
        {
          "id": "read-status",
          "type": "telegram.status.v1",
          "config": {
