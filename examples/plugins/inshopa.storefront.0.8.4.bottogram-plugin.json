{
  "manifestVersion": 2,
  "hostApiMajor": 2,
  "id": "bottogram-plugin-inshopa",
  "name": "این شاپا",
  "version": "0.8.4",
  "executionStatus": "live",
  "description": "ویترین فارسی فروشگاه در تلگرام با مرور محصولات، پیگیری خرید، اعلان سفارش برای مدیر و معرفی محصولات تازه در کانال‌ها و گروه‌های انتخابی فروشگاه.",
  "requiresBotFields": [
    "adminTelegramUserId"
  ],
  "setupFields": [
    {
      "key": "apiKey",
      "label": "کلید API فروشگاه",
      "type": "secret",
      "required": true,
      "helpText": "کلید API همین فروشگاه با مجوزهای storefront:read و shop:orders:read را وارد کنید. آدرس فروشگاه باید همان آدرس ثبت شده برای این کلید باشد. کلید در پیام ها و آدرس عمومی فروشگاه قرار نمی گیرد."
    },
    {
      "key": "storefrontUrl",
      "label": "آدرس HTTPS فروشگاه",
      "type": "text",
      "required": true,
      "helpText": "آدرس همین فروشگاه را مطابق آدرس ثبت شده برای کلید API وارد کنید، مانند shop.example.com یا https://shop.example.com. دامنه بدون پیشوند با HTTPS باز می شود. آدرس سرور API را وارد نکنید."
    },
    {
      "key": "telegramChannelId",
      "label": "شناسه کانال‌ها و گروه‌های تلگرام",
      "type": "telegramChats",
      "required": false,
      "helpText": "اختیاری است. شناسه‌های عددی را در خط‌های جدا یا با ویرگول وارد کنید. ربات باید عضو باشد و در کانال مجوز ارسال پست و در گروه مجوز ارسال عکس داشته باشد.",
      "chatTypes": [
        "channel",
        "group",
        "supergroup"
      ]
    }
  ],
  "settings": [
    {
      "key": "notifyNewSuccessfulPurchases",
      "type": "boolean",
      "label": "اعلان سفارش های پرداخت شده",
      "default": true,
      "helpText": "در نخستین بررسی، سفارش های پرداخت شده قبلی اعلان نمی شوند. پس از آن، سفارش های تازه مشاهده شده با وضعیت پرداخت شده برای مدیر ارسال می شوند."
    }
  ],
  "automations": [
    {
      "id": "buyer-welcome",
      "trigger": {
        "type": "telegram.interaction.v1",
        "config": {
          "routes": [
            {
              "kind": "command",
              "name": "start",
              "argument": "none"
            }
          ],
          "failureText": "به فروشگاه خوش اومدی! برای دیدن منوی متنی /menu یا برای مرور محصولات /products را باز کن.",
          "audience": "visitor"
        }
      },
      "actions": [
        {
          "id": "shop-profile",
          "type": "http.get-json.v1",
          "config": {
            "request": {
              "method": "GET",
              "url": "https://api.inshopa.ir/v1/storefront",
              "authentication": {
                "type": "bearer",
                "secretField": "apiKey"
              },
              "headers": {
                "Origin": {
                  "field": "storefrontUrl",
                  "transform": "url.origin"
                },
                "X-Storefront-Host": {
                  "field": "storefrontUrl",
                  "transform": "url.authority"
                }
              }
            },
            "resultKey": "shop",
            "useLastResponse": true
          }
        },
        {
          "id": "present",
          "type": "telegram.present.v1",
          "config": {
            "lines": [
              {
                "text": "به {{event.results.shop.name}} خوش اومدی!",
                "maxLength": 150,
                "when": "results.shop.name"
              },
              {
                "text": "به فروشگاه خوش اومدی!",
                "maxLength": 150,
                "unless": "results.shop.name"
              },
              {
                "text": "{{event.firstName}} جان، خوشحالیم اینجایی.",
                "maxLength": 100,
                "when": "firstName"
              },
              {
                "text": "{{event.results.shop.description}}",
                "maxLength": 145,
                "when": "results.shop.description"
              },
              {
                "text": "محصولات را ببین و هر وقت آماده بودی، خریدت را از همین‌جا شروع کن.",
                "maxLength": 140,
                "unless": "results.shop.description"
              }
            ],
            "keyboard": [
              [
                {
                  "text": "مشاهده محصولات",
                  "callback": "catalog"
                }
              ],
              [
                {
                  "text": "خریدهای من",
                  "webApp": {
                    "originField": "storefrontUrl",
                    "path": "/orders"
                  }
                },
                {
                  "text": "پشتیبانی",
                  "callback": "support"
                }
              ]
            ],
            "widget": {
              "html": "<style>\nbody { margin: 12px; color: var(--tg-theme-text-color); text-align: right; }\nh2 { font-size: 23px; line-height: 1.2; margin: 0 0 8px; overflow-wrap: anywhere; }\np { line-height: 1.45; margin: 5px 0; overflow-wrap: anywhere; }\n.muted { color: var(--tg-theme-hint-color); }\n</style>\n<style>\n.hero { padding: 14px; border-radius: 14px; background: var(--tg-theme-secondary-bg-color); }\n.hero h2 { color: var(--tg-theme-accent-text-color); }\n</style>\n<div dir=\"rtl\" class=\"hero\">\n  <h2 id=\"shop\"></h2>\n  <p id=\"greeting\"></p>\n  <p id=\"intro\" class=\"muted\"></p>\n</div>\n<script>\nfunction draw() {\n  const data = JSON.parse(TelegramWidget.chatData || '{}');\n  document.getElementById('shop').textContent = data.shop || 'فروشگاه';\n  document.getElementById('greeting').textContent =\n    data.name ? data.name + ' جان، خوش اومدی!' : 'خوش اومدی!';\n  document.getElementById('intro').textContent =\n    data.intro || 'محصولات را ببین و هر وقت آماده بودی، خریدت را از همین‌جا شروع کن.';\n}\nTelegramWidget.onEvent('chatDataChanged', draw);\ndraw();\n</script>",
              "data": {
                "shop": {
                  "text": "{{event.results.shop.name}}",
                  "maxLength": 80
                },
                "name": {
                  "text": "{{event.firstName}}",
                  "maxLength": 36
                },
                "intro": {
                  "text": "{{event.results.shop.description}}",
                  "maxLength": 145
                }
              }
            }
          }
        }
      ]
    },
