    {
      "id": "paid-orders",
      "enabledBySetting": "notifyNewSuccessfulPurchases",
      "trigger": {
        "type": "http.poll-list.v1",
        "config": {
          "intervalSeconds": 60,
          "initialSync": "baseline",
          "lookup": {
            "request": {
              "method": "GET",
              "url": "https://api.inshopa.ir/v1/storefront",
              "authentication": {
                "type": "bearer",
                "secretField": "apiKey"
              },
              "headers": {
                "Origin": {
                  "field": "storefrontUrl",
                  "transform": "url.origin"
                },
                "X-Storefront-Host": {
                  "field": "storefrontUrl",
                  "transform": "url.authority"
                }
              }
            },
            "bindings": {
              "shopId": "id"
            }
          },
          "request": {
            "method": "GET",
            "url": "https://api.inshopa.ir/v1/shops/{shopId}/orders",
            "authentication": {
              "type": "bearer",
              "secretField": "apiKey"
            },
            "headers": {
              "Origin": {
                "field": "storefrontUrl",
                "transform": "url.origin"
              },
              "X-Storefront-Host": {
                "field": "storefrontUrl",
                "transform": "url.authority"
              }
            }
          },
          "response": {
            "itemsPath": "orders",
            "itemIdPath": "id"
          },
          "filter": {
            "path": "status",
            "equals": "paid"
          },
          "pagination": {
            "limitQueryParameter": "limit",
            "offsetQueryParameter": "offset",
            "pageSize": 100,
            "maxPages": 1000,
            "pageDelaySeconds": 2
          }
        },
        "errorMap": {
          "http.unauthorized": "shopAccessDenied",
          "http.forbidden": "shopPermissionDenied",
          "http.credentials_unavailable": "keyUnavailable",
          "http.invalid_origin": "apiOriginInvalid",
          "http.invalid_headers": "headerValuesInvalid",
          "http.timeout": "connectionUnavailable",
          "http.request_failed": "connectionUnavailable",
          "http.invalid_response": "orderResponseInvalid",
          "http.rate_limited": "requestsLimited",
          "poll.invalid_response": "orderResponseInvalid",
          "poll.invalid_progress": "orderProgressInvalid",
          "poll.scan_limit_exceeded": "orderScanLimit"
        }
      },
