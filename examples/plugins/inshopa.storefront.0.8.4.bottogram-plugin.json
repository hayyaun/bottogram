            {
              "kind": "callback",
              "name": "catalog-text",
              "argument": "page"
            }
          ],
          "failureText": "بارگذاری محصولات انجام نشد. برای تلاش دوباره /shop یا نسخهٔ متنی /products را باز کن."
        }
